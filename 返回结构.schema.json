{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/news-categories/返回结构.schema.json",
  "title": "新闻分类打标返回结构",
  "description": "主题 + 实体双轨制打标结果的 JSON Schema。included=false 时 theme/entity 为 null；included=true 时 theme/entity 必填。",
  "type": "object",
  "required": ["included", "reason"],
  "properties": {
    "included": {
      "type": "boolean",
      "description": "是否收录。false 表示噪声/非新闻/非足球内容。"
    },
    "theme": {
      "description": "主题分类；included=false 时为 null。",
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "比赛报道",
            "转会与合同",
            "伤病与停赛",
            "场外与花边",
            "财务与商业",
            "深度分析",
            "行政与管理",
            "历史与文化",
            "比赛预测"
          ]
        },
        "sub": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "前瞻", "赛前预告", "首发确认", "战报", "赛果", "延期取消",
              "转入转出", "租借", "续约", "解约退役", "教练更迭",
              "伤病更新", "复出时间表", "停赛",
              "生活动态", "社交媒体热点", "更衣室轶事", "球迷文化", "庆典公益", "球场安保", "法律纠纷",
              "财政公平", "薪资帽", "赞助合同", "转会费构成", "俱乐部财务", "球票商品",
              "数据统计", "战术拆解", "专访", "历史数据对比",
              "规则变更", "章程", "纪律处分", "赛事抽签", "官方公告",
              "经典回顾", "里程碑纪念", "名宿致敬", "逝世悼念",
              "排名奖项", "比分预测", "胜负倾向", "赔率变化", "博彩解读"
            ]
          }
        }
      },
      "required": ["name", "sub"],
      "additionalProperties": false
    },
    "entity": {
      "description": "实体标签列表；included=false 时为 null。",
      "type": ["array", "null"],
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["event", "team", "player", "coach", "organization"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "type": "object",
            "properties": {
              "season": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
              "category": { "type": "string" },
              "city": { "type": "string" },
              "country": { "type": "string" },
              "club": { "type": "string" },
              "birth_year": { "type": "string", "pattern": "^\\d{4}$" },
              "retired": { "type": "boolean" },
              "role": { "type": "string" },
              "team": { "type": "string" },
              "full_name": { "type": "string" },
              "level": { "type": "string", "enum": ["国家级", "洲际", "国际"] }
            },
            "additionalProperties": false
          },
          "remark": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "transfers": {
      "type": "array",
      "description": "转会关系列表，选填；仅 theme.name=转会与合同 时出现。",
      "items": {
        "type": "object",
        "required": ["type", "player", "from"],
        "properties": {
          "type": { "type": "string", "enum": ["转入转出", "租借", "续约", "解约退役"] },
          "player": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "remark": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "coach_changes": {
      "type": "array",
      "description": "教练更迭关系列表，选填；仅 theme.name=转会与合同 且子类含教练更迭时出现。",
      "items": {
        "type": "object",
        "required": ["type", "coach", "team"],
        "properties": {
          "type": { "type": "string", "enum": ["上任", "下课", "续约", "离任"] },
          "coach": { "type": "string", "minLength": 1 },
          "team": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["主教练", "临时主教练", "助理教练"] },
          "remark": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "matches": {
      "type": "array",
      "description": "比赛关系列表，选填；内容能确定主队与客队时输出，无上限，与 entity 无逻辑关联。",
      "items": {
        "type": "object",
        "required": ["home", "away"],
        "properties": {
          "home": { "type": "string", "minLength": 1 },
          "away": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 },
          "referee": { "type": "string", "minLength": 1 },
          "remark": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "description": "消息来源，选填；原文未明确写明来源时省略该字段，禁止臆造。"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "比赛报道" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["前瞻", "赛前预告", "首发确认", "战报", "赛果", "延期取消"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "转会与合同" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["转入转出", "租借", "续约", "解约退役", "教练更迭"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "伤病与停赛" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["伤病更新", "复出时间表", "停赛"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "场外与花边" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["生活动态", "社交媒体热点", "更衣室轶事", "球迷文化", "庆典公益", "球场安保", "法律纠纷"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "财务与商业" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["财政公平", "薪资帽", "赞助合同", "转会费构成", "俱乐部财务", "球票商品"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "深度分析" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["数据统计", "战术拆解", "专访", "历史数据对比"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "行政与管理" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["规则变更", "章程", "纪律处分", "赛事抽签", "官方公告"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "历史与文化" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["经典回顾", "里程碑纪念", "名宿致敬", "逝世悼念"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "theme": { "properties": { "name": { "const": "比赛预测" } } } },
        "required": ["theme"]
      },
      "then": {
        "properties": { "theme": { "properties": { "sub": { "items": { "enum": ["排名奖项", "比分预测", "胜负倾向", "赔率变化", "博彩解读"] } } } } }
      }
    },
    {
      "if": {
        "properties": { "included": { "const": true } },
        "required": ["included"]
      },
      "then": {
        "required": ["theme", "entity"],
        "properties": {
          "theme": { "type": "object" },
          "entity": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "included": { "const": false } },
        "required": ["included"]
      },
      "then": {
        "properties": {
          "theme": { "type": "null" },
          "entity": { "type": "null" }
        }
      }
    }
  ]
}
